[Unit]
Description=Record operating conditions (throttling, load, memory) to the backup pool
Documentation=https://github.com/ftrauernicht/raspi-google-drive-sync

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sample-conditions.sh

# Measured, not assumed: at the default log level this unit produced 212
# journal lines in 55 minutes - a "Starting", a "Deactivated", a "Finished"
# and a "Consumed ... CPU time" every single minute, about 5800 lines a day.
# This project keeps the journal in RAM and capped at 20 MB (see
# docs/architecture.md), so that noise alone evicts everything worth having
# within hours. LogLevelMax filters both this unit's own output and
# systemd's messages about it, which is exactly the chatter in question.
# Anything this script has to say, it says at warning level or in its log.
LogLevelMax=warning

# A oneshot service has no start timeout by default, and
# OnUnitActiveSec= will not re-arm while the unit is still running. So a
# vcgencmd blocked on a wedged firmware mailbox, or an fsync blocked on a
# wedged USB disk, would stop the recording silently and for good - the one
# outcome this unit must not have.
#
# The first value tried here, 30 seconds, was too tight, and it turned a
# busy pool into a broken unit. On 2026-10-28 a six-hour sync saturated the
# single core, and systemd killed this unit at 04:19, 07:19 and 09:19;
# every kill leaves a failed unit behind until the timer fires again, which
# is precisely what an external monitor reports as a fault on a device that
# is merely working. Measured on that board while the transfer ran: a
# sample costs about 3 seconds, but the append and the fsync land on a FUSE
# pool that the transfer blocks in bursts, and individual samples took more
# than a minute.
#
# So the timeout has to mean "the recorder is wedged", not "the pool is
# busy". Five minutes says the former. The latter is the script's own job to
# report, which it does at warning level (SLOW_RUN_WARN_SECONDS) - the one
# level LogLevelMax above still lets through.
TimeoutStartSec=300

# Lowest practical priority for CPU and disk. Honest about the limits: the
# I/O class only bites under an I/O scheduler that honours it (BFQ or CFQ),
# and Pi OS usually runs mq-deadline on USB disks, so treat this as "cannot
# hurt" rather than a guarantee. A recorder that contributes to the load it
# is supposed to measure would be worse than none, and the per-minute fsync
# is the part to watch if that ever shows up.
Nice=10
IOSchedulingClass=idle
