# Copy this file to config.env and fill in your own values.
# config.env is gitignored — never commit your real values.

# --- Device ---
# Hostname you gave the Pi in Raspberry Pi Imager's advanced options.
DEVICE_HOSTNAME=my-drive-backup

# --- Google Drive OAuth client (see docs/setup-guide.md step 3) ---
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=

# --- Notification email (see docs/setup-guide.md step 6) ---
# Use a SEPARATE Google account dedicated to sending notifications, not the
# account you're backing up — see docs/architecture.md for why.
NOTIFY_SENDER_EMAIL=
NOTIFY_APP_PASSWORD=

# One recipient per line will be written to /etc/drive-backup/recipients.txt.
# Set additional recipients directly in that file after setup; this variable
# only seeds the first one.
NOTIFY_RECIPIENT_EMAIL=

# --- Dead-man switch (see docs/setup-guide.md step 8) ---
# Full ping URL from your healthchecks.io check, e.g. https://hc-ping.com/<uuid>
HEALTHCHECK_URL=
